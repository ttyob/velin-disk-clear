    {
      "id": "windows.pagefile_analysis",
      "version": 1,
      "name": "Windows 分页文件",
      "description": "Windows 虚拟内存使用的 pagefile.sys 与 swapfile.sys",
      "purpose": "在物理内存不足时提供虚拟内存，并支持部分系统转储",
      "clean_effect": "直接删除或错误缩小可能导致内存不足、应用崩溃和转储不可用",
      "recommendation": "not_recommended",
      "recommendation_reason": "通常应保持由 Windows 系统管理",
      "category": "system_storage",
      "platform": "windows",
      "enabled": true,
      "risk": "high",
      "default_selected": false,
      "requires_admin": true,
      "supported_windows_versions": [
        "10.0.19045",
        "11"
      ],
      "scope": "machine",
      "size_mode": "allocated",
      "recovery_type": "system_settings",
      "requires_network_after_clean": false,
      "may_sign_out": false,
      "requires_restart": true,
      "process_guard": [],
      "conflicts": [],
      "last_verified_at": "2026-09-03",
      "source": "internal-review",
      "modes": [
        "standard",
        "deep"
      ],
      "help": {
        "summary": "不建议清理；通常保持“由系统管理”。",
        "details": "分页文件用于虚拟内存和系统转储。本应用只展示占用，不读取内容，也不提供删除。",
        "special_warning": "关闭或错误缩小分页文件可能导致应用崩溃、内存不足和蓝屏转储失败。",
        "manual_steps": [
          "点击“打开虚拟内存设置”",
          "在 Windows 系统界面查看当前配置",
          "修改前确认物理内存与应用需求"
        ]
      },
      "scan": {
        "roots": [
          "%SystemDrive%\\pagefile.sys",
