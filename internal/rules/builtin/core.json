    {
      "id": "windows.user_temp",
      "version": 1,
      "name": "用户临时文件",
      "description": "Windows 与应用产生的当前用户临时文件",
      "purpose": "应用保存安装、解压和运行过程中的短期工作数据",
      "clean_effect": "旧文件清理后通常无影响，活动文件会被跳过",
      "recommendation": "recommended",
      "recommendation_reason": "超过 24 小时的临时文件通常已不再使用",
      "category": "system_temp",
      "platform": "windows",
      "enabled": true,
      "risk": "low",
      "default_selected": true,
      "requires_admin": false,
      "supported_windows_versions": [
        "10.0.19045",
        "11"
      ],
      "scope": "current_user",
      "size_mode": "allocated",
      "recovery_type": "none",
      "requires_network_after_clean": false,
      "may_sign_out": false,
      "requires_restart": false,
      "process_guard": [],
      "conflicts": [],
      "last_verified_at": "2026-09-03",
      "source": "internal-review",
      "modes": [
        "quick",
        "standard",
        "deep"
      ],
      "help": {
        "summary": "推荐清理超过 24 小时且未被占用的临时文件。"
      },
      "scan": {
        "roots": [
          "%LOCALAPPDATA%\\Temp"
        ],
        "include": [
          "**/*"
        ],
        "min_age": "24h",
        "stay_on_volume": true,
        "follow_reparse_points": false
      },
      "action": {
        "type": "permanent_delete"
      },
      "safety": {
        "allowed_roots": [
          "%LOCALAPPDATA%\\Temp"
        ],
        "revalidate_before_clean": true
      },
      "rule_type": "system"
    },
