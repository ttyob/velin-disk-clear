{
  "version": 1,
  "rules": [
    {
      "id": "windows.recycle_bin",
      "version": 1,
      "name": "回收站",
      "description": "各固定磁盘中当前用户可以访问的回收站内容",
      "purpose": "暂存用户已删除但仍可恢复的文件",
      "clean_effect": "清空后文件将永久删除，无法再从 Windows 回收站恢复",
      "recommendation": "optional",
      "recommendation_reason": "空间紧张且确认不需要恢复已删除文件时可清空",
      "category": "recycle_bin",
      "platform": "windows",
      "enabled": true,
      "risk": "medium",
      "default_selected": false,
      "requires_admin": false,
      "supported_windows_versions": [
        "10.0.19045",
        "11"
      ],
      "scope": "current_user",
      "size_mode": "allocated",
      "recovery_type": "none",
      "requires_network_after_clean": false,
      "may_sign_out": false,
      "requires_restart": false,
      "process_guard": [],
      "conflicts": [],
      "last_verified_at": "2026-09-03",
      "source": "windows-shell-api",
      "modes": [
        "quick",
        "standard",
        "deep"
      ],
      "help": {
        "summary": "默认不选；确认不再需要恢复其中的文件后再清空。",
        "details": "应用通过 Windows Shell API 分卷统计和清空，不直接修改 $Recycle.Bin 内部文件。",
        "special_warning": "清空后无法通过回收站恢复；若扫描后项目数或大小变化，本次操作会跳过并要求重新扫描。"
      },
      "scan": {
        "roots": [
          "$FIXED_VOLUMES"
        ],
        "include": [
          "*"
        ],
        "stay_on_volume": true,
        "follow_reparse_points": false
      },
      "action": {
        "type": "empty_recycle_bin"
      },
      "safety": {
        "allowed_roots": [
          "$FIXED_VOLUMES"
        ],
        "revalidate_before_clean": true
      },
      "rule_type": "system"
    },
    {
      "id": "windows.wer_queue",
      "version": 1,
      "name": "旧错误报告队列",
      "description": "Windows 错误报告中长期未处理的诊断文件",
      "purpose": "等待系统处理或上传应用与系统故障信息",
      "clean_effect": "删除后会失去对应的历史故障诊断信息",
      "recommendation": "optional",
      "recommendation_reason": "系统稳定时可处理超过 14 天的旧报告",
      "category": "diagnostics",
      "platform": "windows",
      "enabled": true,
      "risk": "medium",
      "default_selected": false,
      "requires_admin": true,
      "supported_windows_versions": [
        "10.0.19045",
        "11"
      ],
      "scope": "machine",
      "size_mode": "allocated",
      "recovery_type": "none",
      "requires_network_after_clean": false,
      "may_sign_out": false,
      "requires_restart": false,
      "process_guard": [
        "WerFault.exe",
        "wermgr.exe"
      ],
      "conflicts": [],
      "last_verified_at": "2026-09-03",
      "source": "internal-review",
      "modes": [
        "standard",
        "deep"
      ],
      "help": {
        "summary": "默认不选；系统稳定且不再排障时可清理 14 天前的队列文件。"
      },
      "scan": {
        "roots": [
          "%PROGRAMDATA%\\Microsoft\\Windows\\WER\\ReportQueue"
        ],
        "include": [
          "**/*"
        ],
        "min_age": "336h",
        "stay_on_volume": true,
        "follow_reparse_points": false
      },
      "action": {
        "type": "permanent_delete"
      },
      "safety": {
        "allowed_roots": [
          "%PROGRAMDATA%\\Microsoft\\Windows\\WER\\ReportQueue"
        ],
        "revalidate_before_clean": true
      },
      "rule_type": "system"
    },
    {
      "id": "windows.cbs_archives",
      "version": 1,
      "name": "CBS 旧归档日志",
      "description": "Windows 组件维护产生的旧 CAB 归档日志",
      "purpose": "记录系统组件安装、更新与修复过程",
      "clean_effect": "只失去超过 30 天的历史维护记录，不影响系统组件",
      "recommendation": "recommended",
      "recommendation_reason": "仅匹配可删除的旧 CAB 归档并保留近期日志",
      "category": "diagnostics",
      "platform": "windows",
      "enabled": true,
      "risk": "low",
      "default_selected": true,
      "requires_admin": true,
      "supported_windows_versions": [
        "10.0.19045",
        "11"
      ],
      "scope": "machine",
      "size_mode": "allocated",
      "recovery_type": "none",
      "requires_network_after_clean": false,
      "may_sign_out": false,
      "requires_restart": false,
      "process_guard": [
        "TiWorker.exe",
        "TrustedInstaller.exe"
      ],
      "conflicts": [],
      "last_verified_at": "2026-09-03",
      "source": "internal-review",
      "modes": [
        "standard",
        "deep"
      ],
      "help": {
        "summary": "推荐清理 30 天前的 CBS CAB 归档；当前日志和普通 LOG 文件不会命中。"
      },
      "scan": {
        "roots": [
          "%WINDIR%\\Logs\\CBS"
        ],
        "extensions": [
          ".cab"
        ],
        "min_age": "720h",
        "stay_on_volume": true,
        "follow_reparse_points": false
      },
      "action": {
        "type": "permanent_delete"
      },
      "safety": {
        "allowed_roots": [
          "%WINDIR%\\Logs\\CBS"
        ],
        "revalidate_before_clean": true
      },
      "rule_type": "system"
    },
