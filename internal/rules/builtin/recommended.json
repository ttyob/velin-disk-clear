    {
      "id": "windows.downloads_installers",
      "version": 1,
      "name": "下载目录旧安装包",
      "description": "下载目录中超过 30 天的安装包和系统镜像",
      "purpose": "保存软件下载、离线安装和系统安装介质",
      "clean_effect": "永久删除后需要重新下载，也可能失去唯一的离线安装介质",
      "recommendation": "analyze_only",
      "recommendation_reason": "只列出候选，必须逐项确认软件已安装且不再需要离线副本",
      "category": "large_files",
      "platform": "windows",
      "enabled": true,
      "risk": "high",
      "default_selected": false,
      "requires_admin": false,
      "supported_windows_versions": [
        "10.0.19045",
        "11"
      ],
      "scope": "current_user",
      "size_mode": "allocated",
      "recovery_type": "none",
      "requires_network_after_clean": true,
      "may_sign_out": false,
      "requires_restart": false,
      "process_guard": [],
      "conflicts": [],
      "last_verified_at": "2026-09-03",
      "source": "internal-review",
      "modes": [
        "standard",
        "deep"
      ],
      "help": {
        "summary": "默认不选；仅在确认软件已安装且无需离线副本后逐项永久删除。",
        "details": "扫描 EXE、MSI、MSIX、APPX、APPXBUNDLE 和 ISO，不会自动勾选。",
        "special_warning": "文件可能是付费软件、驱动程序或系统恢复介质的唯一副本。",
        "manual_steps": [
          "确认对应软件已经安装",
          "核对发布者和文件用途",
          "确认可重新下载或已有备份"
        ]
      },
      "scan": {
        "roots": [
          "%USERPROFILE%\\Downloads"
        ],
        "extensions": [
          ".exe",
          ".msi",
          ".msix",
          ".appx",
          ".appxbundle",
          ".iso"
        ],
        "min_age": "720h",
        "stay_on_volume": true,
        "follow_reparse_points": false
      },
      "action": {
        "type": "permanent_delete"
      },
      "safety": {
        "allowed_roots": [
          "%USERPROFILE%\\Downloads"
        ],
        "revalidate_before_clean": true
      },
      "rule_type": "system"
    },
