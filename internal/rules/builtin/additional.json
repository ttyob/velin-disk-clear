    {
      "id": "windows.update_download_analysis",
      "version": 1,
      "name": "Windows 更新下载缓存",
      "description": "SoftwareDistribution Download 中尚由更新服务管理的下载内容",
      "purpose": "保存 Windows 更新安装包、分块下载和恢复数据",
      "clean_effect": "错误删除可能中断更新、导致重新下载或触发更新修复",
      "recommendation": "analyze_only",
      "recommendation_reason": "只展示占用，建议通过 Windows 存储设置或疑难解答处理",
      "category": "update_cache",
      "platform": "windows",
      "enabled": true,
      "default_selected": false,
      "risk": "high",
      "requires_admin": true,
      "supported_windows_versions": [
        "10.0.19045",
        "11"
      ],
      "scope": "machine",
      "size_mode": "allocated",
      "recovery_type": "system_settings",
      "requires_network_after_clean": true,
      "may_sign_out": false,
      "requires_restart": false,
      "process_guard": [
        "wuauserv",
        "UsoClient.exe",
        "MoUsoCoreWorker.exe"
      ],
      "conflicts": [],
      "last_verified_at": "2026-09-03",
      "source": "internal-review",
      "modes": [
        "deep"
      ],
      "help": {
        "summary": "仅分析且默认不选；不要在更新进行中手动删除。",
        "details": "该目录由 Windows Update 服务维护，本应用只统计文件，不提供直接删除。",
        "special_warning": "强制删除可能破坏正在进行的更新并造成重复下载。",
        "manual_steps": [
          "确认 Windows 更新没有正在下载或安装",
          "优先使用 Windows 设置中的临时文件清理",
          "更新异常时先运行 Windows 更新疑难解答"
        ]
      },
      "scan": {
        "roots": [
          "%WINDIR%\\SoftwareDistribution\\Download"
        ],
        "include": [
          "**/*"
        ],
        "stay_on_volume": true,
        "follow_reparse_points": false
      },
      "action": {
        "type": "analyze"
      },
      "safety": {
        "allowed_roots": [
          "%WINDIR%\\SoftwareDistribution\\Download"
        ],
        "revalidate_before_clean": true
      },
      "rule_type": "system"
    },
    {
      "id": "windows.prefetch_analysis",
      "version": 1,
      "name": "Windows 预读取文件",
      "description": "Windows 为应用和启动过程生成的 Prefetch 性能数据",
      "purpose": "帮助系统优化应用启动和开机加载顺序",
      "clean_effect": "清理不会释放很多空间，反而会让应用和系统重新学习启动数据",
      "recommendation": "not_recommended",
      "recommendation_reason": "通常应由 Windows 自行维护，不应作为常规垃圾清理",
      "category": "system_storage",
      "platform": "windows",
      "enabled": true,
      "default_selected": false,
      "risk": "high",
      "requires_admin": true,
      "supported_windows_versions": [
        "10.0.19045",
        "11"
      ],
      "scope": "machine",
      "size_mode": "allocated",
      "recovery_type": "none",
      "requires_network_after_clean": false,
      "may_sign_out": false,
      "requires_restart": false,
      "process_guard": [],
      "conflicts": [],
      "last_verified_at": "2026-09-03",
      "source": "internal-review",
      "modes": [
        "deep"
      ],
      "help": {
        "summary": "不建议清理；预读取数据通常占用很小，并能改善启动性能。",
        "details": "Windows 会自动维护 Prefetch。频繁删除只会造成缓存重建，不会带来稳定的空间收益。",
        "special_warning": "清理后应用和系统启动可能暂时变慢。",
        "manual_steps": [
          "保持 Windows 默认管理",
          "仅在诊断预读取异常时由专业人员处理"
        ]
      },
      "scan": {
        "roots": [
          "%WINDIR%\\Prefetch"
        ],
        "extensions": [
          ".pf"
        ],
        "stay_on_volume": true,
        "follow_reparse_points": false
      },
      "action": {
        "type": "analyze"
      },
      "safety": {
        "allowed_roots": [
          "%WINDIR%\\Prefetch"
        ],
        "revalidate_before_clean": true
      },
      "rule_type": "system"
    },
