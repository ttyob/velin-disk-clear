    {
      "id": "windows.uwp_temp_state",
      "version": 1,
      "name": "商店应用临时状态",
      "description": "Microsoft Store 应用 TempState 目录中的旧临时文件",
      "purpose": "商店应用在运行、分享和后台任务中保存短期状态",
      "clean_effect": "旧临时状态会在需要时重新生成，个别应用首次启动可能稍慢",
      "recommendation": "recommended",
      "recommendation_reason": "仅处理超过 7 天的 TempState 文件，不触及应用设置和用户数据",
      "category": "app_cache",
      "platform": "windows",
      "enabled": true,
      "default_selected": true,
      "risk": "low",
      "requires_admin": false,
      "supported_windows_versions": [
        "10.0.19045",
        "11"
      ],
      "scope": "current_user",
      "size_mode": "allocated",
      "recovery_type": "none",
      "requires_network_after_clean": false,
      "may_sign_out": false,
      "requires_restart": false,
      "process_guard": [],
      "conflicts": [],
      "last_verified_at": "2026-09-03",
      "source": "windows-app-layout",
      "modes": [
        "standard",
        "deep"
      ],
      "help": {
        "summary": "推荐清理 7 天前的商店应用临时状态；应用设置、账号和文档不会命中。"
      },
      "scan": {
        "roots": [
          "%LOCALAPPDATA%\\Packages\\*\\TempState"
        ],
        "include": [
          "**/*"
        ],
        "min_age": "168h",
        "stay_on_volume": true,
        "follow_reparse_points": false
      },
      "action": {
        "type": "permanent_delete"
      },
      "safety": {
        "allowed_roots": [
          "%LOCALAPPDATA%\\Packages"
        ],
        "revalidate_before_clean": true
      },
      "rule_type": "system"
    },
